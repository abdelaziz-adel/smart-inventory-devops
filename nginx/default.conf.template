server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/products {
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
    }
    location /api/reports {
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
    }
    location /api/alerts {
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://${ALERTS_UPSTREAM};
        proxy_set_header Host $host;
    }
    location / { try_files $uri $uri/ /index.html; }
}
